formulas:
  Untitled: description.slice(0, 150) + "..."
properties:
  formula.Untitled:
    displayName: Description
views:
  - type: cards
    name: Table
    filters:
      and:
        - file.inFolder("projects")
        - file.ext == "md"
        - file.name != "index"
    order:
      - file.name
      - tags
      - formula.Untitled
    sort:
      - property: date
        direction: DESC
    cardSize: 320
    imageAspectRatio: 1.65
    image: note.image
    imageFit: contain
