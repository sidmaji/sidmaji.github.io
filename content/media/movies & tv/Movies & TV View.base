model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: cards
    name: Table
    filters:
      and:
        - file.folder == "media/movies & tv"
        - file.ext == "md"
        - file.name != "index"
    order:
      - englishTitle
      - genres
      - onlineRating
    sort:
      - property: onlineRating
        direction: DESC
    imageFit: contain
    imageAspectRatio: 1.45
    image: note.image
