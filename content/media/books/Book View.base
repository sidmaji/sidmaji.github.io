views:
  - type: cards
    name: Table
    filters:
      and:
        - file.folder == "media/books"
        - file.hasProperty("author")
    order:
      - title
      - author
      - read
    sort:
      - property: read
        direction: DESC
    imageFit: contain
    image: note.cover
    cardSize: 220
    imageAspectRatio: 1.5
